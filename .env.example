MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rapidreach
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Used only to bootstrap the first admin account on a fresh database.
# After that, admin access is controlled by the role stored on the user record.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Needed for local Blob uploads / token-based Blob stores. New Vercel projects can use Blob OIDC instead.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_store_token

# Optional weekly briefing delivery. Signup/subscriber storage works without these,
# but the admin Send action requires a verified Resend sender.
RESEND_API_KEY=re_your_resend_api_key
BRIEFING_FROM_EMAIL=RapidReach <briefing@your-domain.com>
